{
  "version": 1,
  "steps": [
    {
      "run": "cli_ollama.py",
      "args": ["--project", "project_matrix"]
    },
    {
      "run": "cli_ollama.py",
      "args": ["--clear_log"]
    },
    {
      "run": "cli_ollama.py",
      "args": ["--clear-out", "task_answers_model_{run_timestamp}.txt"]
    },
    {
      "run": "cli_ollama.py",
      "args": [
        "--type", "task_base.json",
        "--model", "{model}",
        "--temp", "{temp}",
        "--seed", "{seed}",
        "--out", "task_answers_model_{run_timestamp}.txt",
        "--append-out",
        "--out-header", "[model: {model}] [seed: {seed}] [temp: {temp}]"
      ],
      "matrix": {
        "model": ["gemma4:latest", "qwen3.5:latest"],
        "temp": [0.1, 0.5, 0.9],
        "seed": [1, 21, 42, 123, 666]
      }
    }
  ]
}
