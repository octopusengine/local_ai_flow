{
  "version": 1,
  "steps": [
    {
      "run": "cli_ollama.py",
      "args": ["--project", "project_example"]
    },
    {
      "run": "cli_ollama.py",
      "args": ["--clear_log"]
    },
    {
      "run": "cli_ollama.py",
      "args": [
        "--type", "task_base.json",
        "--temp", "{temp}",
        "--out", "task_base_temp_{temp}.txt"
      ],
      "matrix": {
        "temp": [0.1, 0.5, 0.9]
      }
    }
  ]
}
