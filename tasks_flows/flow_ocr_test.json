{
  "version": 2,
  "steps": [
    {
      "run": "cli_ollama.py",
      "args": ["--type", "task_ocr.json", "--in", "camera.png", "--out", "ocr_test.txt"]
    },
    {
      "if": {"file_not_empty": "ocr_test.txt"},
      "then": [
        {
          "run": "cli_ollama.py",
          "args": [
            "--type", "task_translate.json",
            "--direction",
            "c2a",
            "--in", "ocr_test.txt",
            "--out", "ocr_test_translated.txt"
          ]
        }
      ],
      "else": [
        {
          "run": "cli_ollama.py",
          "args": ["--echo", "OCR nevytvorilo pouzitelny text; preklad se preskakuje."]
        }
      ]
    }
  ]
}
